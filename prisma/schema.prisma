generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nama      String
  username  String   @unique
  password  String
  role      String
  divisi    String
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  invoice     String
  divisi      String
  qtySelesai  Int
  kendala     String
  createdAt   DateTime @default(now())
}