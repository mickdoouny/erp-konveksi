generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AccountingTransaction {
  id                 String          @id
  finalOrderId       String          @unique
  invoiceNumber      String          @unique
  currency           String          @default("IDR")
  totalHarga         Int
  dp                 Int             @default(0)
  sisaPelunasan      Int
  paymentStatus      PaymentStatus   @default(MENUNGGU_DP)
  tanggalDp          DateTime?
  tanggalPelunasan   DateTime?
  buktiDp            String?
  dpExemptApproved   Boolean         @default(false)
  dpExemptReason     String?
  dpExemptApprovedBy String?
  dpExemptApprovedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime
  FinalOrder         FinalOrder      @relation(fields: [finalOrderId], references: [id], onDelete: Cascade)
  PaymentLedger      PaymentLedger[]

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([tanggalDp])
  @@index([tanggalPelunasan])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Customer {
  id         String       @id
  nama       String
  noHp       String
  alamat     String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  FinalOrder FinalOrder[]

  @@index([createdAt])
  @@index([noHp])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DesignQueueItem {
  id                   String                  @id
  leadCode             String?                 @unique
  namaKonsumen         String
  namaArtikel          String
  materiDesain         String?
  prioritas            DesignQueuePrioritas    @default(REGULER)
  statusDesain         DesignQueueStatusDesain @default(MENUNGGU)
  csId                 String?
  csNama               String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime
  processedAt          DateTime?
  approvedAt           DateTime?
  artikelId            String                  @unique
  assignedDesignerId   String?
  assignedDesignerNama String?
  designId             String
  finalDesignFile      String?
  returnedToCsAt       DateTime?
  desainUtama          String?
  logoSponsor          String?
  hasilDesain          String?
  accSubmittedAt       DateTime?
  alamatPengiriman     String?
  dpAmount             Int?
  jenisBahan           String?
  jenisKerah           String?
  jenisOrder           String?
  lengan               String?
  noTelepon            String?
  noTeleponNormalized  String?
  readyForAdmin        Boolean                 @default(false)
  sisaPelunasan        Int?
  sppNumber            String?
  tanggalBayarDp       DateTime?
  tanggalDeadline      DateTime?
  jenisProduksi        JenisProduksi           @default(REGULER)
  expressPriority      Int?
  totalOrder           Int?
  revisionCount        Int                     @default(0)
  buktiDp              String?
  hargaSatuan          Int?
  fileDesainProduksi   String?
  sppGroupId           String?
  catatanFinishing     String?
  ongkosKirim          Int?
  perluDtf             Boolean                 @default(false)
  catatanDtf           String?
  statusDtf            DtfStatus               @default(TIDAK_PERLU)
  fileDtfVendor        String?
  fileDtfProof         String?
  dtfVendorId          String?
  DtfPaymentRequest    DtfPaymentRequest[]
  DtfVendor            DtfVendor?              @relation(fields: [dtfVendorId], references: [id])
  DesignQueueMessage   DesignQueueMessage[]
  FinalOrder           FinalOrder?

  @@index([perluDtf, statusDtf])
  @@index([dtfVendorId])

  @@index([assignedDesignerId])
  @@index([csId])
  @@index([noTeleponNormalized])
  @@index([designId])
  @@index([prioritas, createdAt])
  @@index([jenisProduksi, expressPriority])
  @@index([readyForAdmin])
  @@index([sppGroupId])
  @@index([statusDesain])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DesignQueueMessage {
  id                String                    @id
  designQueueItemId String
  senderRole        DesignQueueNoteSenderRole
  senderName        String
  message           String
  createdAt         DateTime                  @default(now())
  DesignQueueItem   DesignQueueItem           @relation(fields: [designQueueItemId], references: [id], onDelete: Cascade)

  @@index([designQueueItemId, createdAt])
}

/// Master vendor DTF — dikelola owner/admin, dipilih admin produksi saat order.
model DtfVendor {
  id                String              @id
  name              String
  contact           String?
  phone             String?
  bankAccount       String?
  notes             String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  DesignQueueItem   DesignQueueItem[]
  DtfPaymentRequest DtfPaymentRequest[]

  @@index([isActive, name])
}

/// Master operator per divisi/tahap — dikelola owner.
model Operator {
  id           String             @id
  name         String
  department   OperatorDepartment
  username     String             @unique
  passwordHash String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())

  @@index([department, isActive, name])
}

/// Permintaan pembayaran vendor DTF — diajukan admin produksi, disetujui keuangan.
model DtfPaymentRequest {
  id                String                   @id
  designQueueItemId String
  vendorId          String
  nominal           Int
  status            DtfPaymentRequestStatus  @default(MENUNGGU)
  requestedBy       String
  requestedAt       DateTime                 @default(now())
  approvedBy        String?
  approvedAt        DateTime?
  buktiBayarUrl     String?
  notes             String?
  DesignQueueItem   DesignQueueItem          @relation(fields: [designQueueItemId], references: [id], onDelete: Cascade)
  DtfVendor         DtfVendor                @relation(fields: [vendorId], references: [id])

  @@index([status, requestedAt])
  @@index([designQueueItemId])
  @@index([vendorId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FinalOrder {
  id                    String                 @id
  orderNumber           String                 @unique
  status                FinalOrderStatus       @default(DRAFT)
  submittedAt           DateTime?
  submittedByUserId     String?
  submittedByName       String?
  namaCs                String
  customerId            String?
  namaKonsumen          String
  noHp                  String
  alamat                String?
  namaArtikel           String
  jenisOrder            String?
  bahan                 String?
  jenisKerah            String?
  jenisLengan           String?
  qty                   Int
  deadline              DateTime?
  jenisProduksi         JenisProduksi          @default(REGULER)
  expressPriority       Int?
  needsKancing          Boolean                @default(false)
  needsDTF              Boolean                @default(false)
  fileDesainFinal       String?
  mockupApprovedAt      DateTime?
  catatanProduksi       String?
  catatanCs             String?
  hargaSatuan           Int?
  hargaStelan           Int?
  hargaAtasan           Int?
  hargaBawahan          Int?
  totalHarga            Int
  dp                    Int                    @default(0)
  sisaPelunasan         Int
  tanggalDp             DateTime?
  tanggalPelunasan      DateTime?
  buktiDp               String?
  legacyLeadOrderId     String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  deliveredAt           DateTime?
  deliveryStatus        DeliveryStatus         @default(BELUM_KIRIM)
  designQueueItemId     String?                @unique
  ongkosKirim           Int?
  AccountingTransaction AccountingTransaction?
  Customer              Customer?              @relation(fields: [customerId], references: [id])
  DesignQueueItem       DesignQueueItem?       @relation(fields: [designQueueItemId], references: [id])
  FinalOrderRosterLine  FinalOrderRosterLine[]
  ProductionPipeline    ProductionPipeline?
  JahitPaymentRecord    JahitPaymentRecord[]

  @@index([createdAt])
  @@index([jenisProduksi, expressPriority])
  @@index([deliveryStatus])
  @@index([namaCs])
  @@index([needsKancing, needsDTF])
  @@index([status])
  @@index([submittedAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FinalOrderRosterLine {
  id            String     @id
  finalOrderId  String
  nama          String
  nomorPunggung String?
  ukuran        String?
  catatan       String?
  jenisItem     String?
  jenisKerah    String?
  lengan        String?
  bahan         String?
  warna         String?
  grup          String?
  sortOrder     Int        @default(0)
  FinalOrder    FinalOrder @relation(fields: [finalOrderId], references: [id], onDelete: Cascade)

  @@index([finalOrderId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LeadMessage {
  id          String    @id
  leadOrderId String
  senderRole  String
  senderName  String
  message     String?
  fileUrl     String?
  createdAt   DateTime  @default(now())
  LeadOrder   LeadOrder @relation(fields: [leadOrderId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LeadOrder {
  id                      String                  @id
  leadCode                String                  @unique
  namaCs                  String
  namaKonsumen            String
  noHp                    String
  alamat                  String?
  namaArtikel             String
  jenisOrder              String?
  bahan                   String?
  jenisKerah              String?
  jenisLengan             String?
  qty                     Int?
  catatanDesain           String?
  materiDesain            String?
  fileMockup              String?
  fileFinalDesain         String?
  hargaSatuan             Int?
  totalHarga              Int?
  dp                      Int?
  sisaPelunasan           Int?
  tanggalDp               DateTime?
  tanggalPelunasan        DateTime?
  buktiDp                 String?
  statusLead              String                  @default("PROSPEK")
  statusDesain            String                  @default("BELUM MASUK DESAIN")
  statusPembayaran        String                  @default("BELUM DP")
  alasanTidakLanjut       String?
  approvedDesignAt        DateTime?
  validatedDpAt           DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime
  catatanRevisi           String?
  hasilDesain             String?
  designAgreedAt          DateTime?
  dpExemptApprovedAt      DateTime?
  dpExemptApprovedBy      String?
  dpExemptReason          String?
  dpExemptRejectionReason String?
  dpExemptRequested       Boolean                 @default(false)
  dpExemptStatus          String                  @default("NONE")
  LeadMessage             LeadMessage[]
  Order                   Order?
  OrderRosterLine         OrderRosterLine[]
  ProductionRequest       ProductionRequest[]
  SuratPerintahProduksi   SuratPerintahProduksi[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Order {
  id                    String                 @id
  noInvoice             String                 @unique
  namaCs                String
  namaKonsumen          String
  alamat                String
  noHp                  String
  tanggalProduksi       DateTime?
  deadline              DateTime?
  orderType             String
  jenisKerah            String
  jenisLengan           String
  bahan                 String
  qty                   Int
  hargaSatuan           Int
  totalHarga            Int
  dp                    Int
  sisaPelunasan         Int
  beratBahan            Float
  konsumsiTinta         Float
  panjangKertas         Float
  status                String                 @default("DESAIN")
  createdAt             DateTime               @default(now())
  adminValidation       Boolean                @default(false)
  buktiDp               String?
  mockupDesign          String?
  paymentStatus         String                 @default("MENUNGGU DP")
  tanggalDp             DateTime?
  tanggalPelunasan      DateTime?
  leadOrderId           String?                @unique
  LeadOrder             LeadOrder?             @relation(fields: [leadOrderId], references: [id])
  SuratPerintahProduksi SuratPerintahProduksi?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model OrderRosterLine {
  id            String    @id
  leadOrderId   String
  nama          String
  nomorPunggung String?
  ukuran        String?
  catatan       String?
  sortOrder     Int       @default(0)
  LeadOrder     LeadOrder @relation(fields: [leadOrderId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PaymentLedger {
  id                    String                @id
  accountingId          String
  type                  PaymentLedgerType
  amount                Int
  buktiUrl              String?
  recordedAt            DateTime              @default(now())
  recordedByUserId      String?
  recordedByName        String
  note                  String?
  AccountingTransaction AccountingTransaction @relation(fields: [accountingId], references: [id], onDelete: Cascade)

  @@index([accountingId])
  @@index([type, recordedAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductionOperatorAssignment {
  id                   String                 @id
  productionPipelineId String
  stage                ProductionStatus?
  userId               String
  assignmentRole       OperatorAssignmentRole @default(PRIMARY)
  assignedAt           DateTime               @default(now())
  unassignedAt         DateTime?
  assignedByUserId     String?
  ProductionPipeline   ProductionPipeline     @relation(fields: [productionPipelineId], references: [id], onDelete: Cascade)
  User                 User                   @relation(fields: [userId], references: [id])

  @@index([productionPipelineId, stage])
  @@index([stage, assignmentRole])
  @@index([userId, assignedAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductionPipeline {
  id                           String                         @id
  finalOrderId                 String                         @unique
  productionNumber             String                         @unique
  pipelineVersion              Int                            @default(1)
  currentStatus                ProductionStatus               @default(ADMIN_PRODUKSI)
  adminProduksiStatus          AdminProduksiStatus            @default(PENDING)
  adminValidatedAt             DateTime?
  adminValidatedBy             String?
  needsKancing                 Boolean                        @default(false)
  needsDTF                     Boolean                        @default(false)
  kancingCompletedAt           DateTime?
  dtfCompletedAt               DateTime?
  currentOperatorId            String?
  deadline                     DateTime?
  priority                     String                         @default("NORMAL")
  isOnHold                     Boolean                        @default(false)
  holdReason                   String?
  completedAt                  DateTime?
  beratBahan                   Float?
  konsumsiTinta                Float?
  panjangKertas                Float?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime
  shipReleaseNote              String?
  shipReleaseRequestedAt       DateTime?
  shipReleaseRequestedBy       String?
  shipReleaseStatus            ShipReleaseStatus              @default(NONE)
  shipReleaseValidatedAt       DateTime?
  shipReleaseValidatedBy       String?
  ProductionOperatorAssignment ProductionOperatorAssignment[]
  FinalOrder                   FinalOrder                     @relation(fields: [finalOrderId], references: [id], onDelete: Cascade)
  ProductionStagePlan          ProductionStagePlan[]
  ProductionStatusHistory      ProductionStatusHistory[]
  JahitPaymentRecord           JahitPaymentRecord[]

  @@index([adminProduksiStatus])
  @@index([completedAt])
  @@index([createdAt])
  @@index([currentStatus, adminProduksiStatus])
  @@index([currentStatus])
  @@index([deadline])
  @@index([needsKancing, needsDTF])
  @@index([priority])
  @@index([shipReleaseStatus])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductionRequest {
  id                    String                 @id
  leadOrderId           String
  requestedBy           String
  requestedAt           DateTime               @default(now())
  requestType           String
  status                String                 @default("PENDING_ADMIN")
  notesCs               String?
  rejectionReason       String?
  LeadOrder             LeadOrder              @relation(fields: [leadOrderId], references: [id], onDelete: Cascade)
  SuratPerintahProduksi SuratPerintahProduksi?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductionStagePlan {
  id                   String             @id
  productionPipelineId String
  stage                ProductionStatus
  sequence             Int
  isRequired           Boolean            @default(true)
  status               StagePlanStatus    @default(PENDING)
  plannedStartAt       DateTime?
  plannedEndAt         DateTime?
  actualStartAt        DateTime?
  actualEndAt          DateTime?
  estimatedMinutes     Int?
  delayMinutes         Int?
  ProductionPipeline   ProductionPipeline @relation(fields: [productionPipelineId], references: [id], onDelete: Cascade)

  @@unique([productionPipelineId, stage])
  @@index([productionPipelineId, sequence])
  @@index([stage, status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductionStatusHistory {
  id                   String              @id
  productionPipelineId String
  fromStatus           ProductionStatus?
  toStatus             ProductionStatus
  eventType            ProductionEventType
  changedByUserId      String?
  changedByName        String
  changedByRole        String
  note                 String?
  metadata             Json?
  createdAt            DateTime            @default(now())
  ProductionPipeline   ProductionPipeline  @relation(fields: [productionPipelineId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
  @@index([productionPipelineId, createdAt])
  @@index([toStatus, createdAt])
}

/// Rekam selesai jahit untuk pengajuan pembayaran (closing Sabtu).
model JahitPaymentRecord {
  id                   String             @id
  productionPipelineId String
  finalOrderId         String
  orderNumber          String
  qty                  Int
  operatorId           String?
  operatorName         String
  completedAt          DateTime           @default(now())
  FinalOrder           FinalOrder         @relation(fields: [finalOrderId], references: [id], onDelete: Cascade)
  ProductionPipeline   ProductionPipeline @relation(fields: [productionPipelineId], references: [id], onDelete: Cascade)

  @@index([completedAt])
  @@index([finalOrderId])
  @@index([productionPipelineId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Report {
  id         String   @id
  invoice    String
  divisi     String
  qtySelesai Int
  kendala    String
  createdAt  DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SuratPerintahProduksi {
  id                  String            @id
  sppNumber           String            @unique
  productionRequestId String            @unique
  leadOrderId         String
  orderId             String?           @unique
  issuedBy            String
  issuedAt            DateTime          @default(now())
  status              String            @default("TERBIT")
  LeadOrder           LeadOrder         @relation(fields: [leadOrderId], references: [id])
  Order               Order?            @relation(fields: [orderId], references: [id])
  ProductionRequest   ProductionRequest @relation(fields: [productionRequestId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id                           String                         @id
  nama                         String
  username                     String                         @unique
  password                     String
  role                         String
  divisi                       String
  createdAt                    DateTime                       @default(now())
  csId                         String?                        @unique
  dsId                         String?                        @unique
  ProductionOperatorAssignment ProductionOperatorAssignment[]
}

enum AdminProduksiStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryStatus {
  BELUM_KIRIM
  TERKIRIM
}

enum DesignQueueNoteSenderRole {
  CS
  DESAINER
}

enum DesignQueuePrioritas {
  REGULER
  EXPRESS
}

enum JenisProduksi {
  REGULER
  EXPRESS
}

enum DesignQueueStatusDesain {
  MENUNGGU
  SEDANG_DIPROSES
  SELESAI
  DIKEMBALIKAN_CS
  DISETUJUI_CS
  FILE_DISETUJUI_UPLOADED
  SUDAH_DI_DESAIN
  SUDAH_DI_REVISI
  MENUNGGU_ACC_KONSUMEN
  MENUNGGU_DP
}

enum FinalOrderStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum OperatorAssignmentRole {
  PRIMARY
  HELPER
  SUPERVISOR
}

enum PaymentLedgerType {
  DP
  PELUNASAN
  ADJUSTMENT
  REFUND
}

enum PaymentStatus {
  MENUNGGU_DP
  DP_TERIMA
  SEBAGIAN
  LUNAS
  DP_DIKECUALIKAN
}

enum ProductionEventType {
  ORDER_CREATED
  ADMIN_APPROVED
  ADMIN_REJECTED
  STAGE_ADVANCED
  STAGE_ROLLBACK
  HOLD_STARTED
  HOLD_ENDED
  OPERATOR_ASSIGNED
  OPERATOR_UNASSIGNED
}

enum ProductionStatus {
  ADMIN_PRODUKSI
  SETTING
  LAYOUT_PRINT
  PRINTING
  PREPARE_BAHAN_KAIN
  POTONG_KERTAS
  TIMBANG_HASIL_POTONG
  PRESS
  JAHIT
  FINISHING
  KANCING
  DTF
  PACKING
  BARANG_SELESAI
  SIAP_KIRIM
}

enum ShipReleaseStatus {
  NONE
  MENUNGGU_VALIDASI
  DISETUJUI
  DITOLAK
}

enum StagePlanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum DtfStatus {
  TIDAK_PERLU
  MENUNGGU_ORDER
  DI_VENDOR
  MENUNGGU_BAYAR
  DIBAYAR
  SIAP_PRODUKSI
}

enum DtfPaymentRequestStatus {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum OperatorDepartment {
  SALES
  DESAINER
  SETTING
  LAYOUT
  PREPARE
  PRESS
  JAHIT
  FINISHING
}
